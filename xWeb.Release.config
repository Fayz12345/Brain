        <scripting>
            <scriptResourceHandler enableCompression="true"/>
            <webServices>
                <authenticationService enabled="true"
                   requireSSL = "true"/>
            </webServices>
        </scripting>
    </system.web.extensions>-->

    
    
    
    
    <system.net xdt:Transform="Replace">
        <mailSettings>
            <smtp deliveryMethod="Network" from="jim.willson@hotmail.com">
                <network defaultCredentials="false" host="mail.notebookdepot.com" userName="xxxxxx"  password="xxxxxx" />
            </smtp>
        </mailSettings>
    </system.net>

</configuration>