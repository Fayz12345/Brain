    <!-- Syncfusion / jquery mismatch fix?... Keep disabled for the time being. -->
    <%--<script src="http://code.jquery.com/jquery-migrate-1.2.0.min.js" type="text/javascript"></script>--%>
    <!-- Menu / nav fix -->
    <script type="text/javascript">

        // remove menu hover
        Sys.WebForms.Menu._elementObjectMapper.getMappedObject = function () {
            return false;
        };

        $(function () {
            // remove garbage
            $('#main-menu ul, #main-menu ul li, #main-menu ul li a').removeAttr('style');

            // add missing nav classes
            $('#main-menu ul li').not('.dynamic').addClass('nav-item');
            $('#main-menu ul li.has-popup').addClass('dropdown');
            $('#main-menu ul li.has-popup > a').addClass('dropdown-toggle').attr('href', '#').attr('data-toggle', 'dropdown');
            $('#main-menu ul li.has-popup li.has-popup').removeClass('dropdown').addClass('dropdown-submenu');
            $('a.selected').closest('li').addClass('active');
            $('a.selected').closest('.dropdown-toggle').addClass('active');

            // add submenu functionality
            $('.dropdown-menu a.dropdown-toggle').on('click', function (e) {
                if (!$(this).next().hasClass('show')) {
                    $(this).parents('.dropdown-menu').first().find('.show').removeClass("show");
                }
                var $subMenu = $(this).next(".dropdown-menu");
                $subMenu.toggleClass('show');

                $(this).parents('li.nav-item.dropdown.show').on('hidden.bs.dropdown', function (e) {
                    $('.dropdown-submenu .show').removeClass("show");
                });

                return false;
            });
        });

//        function jmbeep(times) {
