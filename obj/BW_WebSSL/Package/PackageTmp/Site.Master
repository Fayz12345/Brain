<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="BM_WebApp.SiteMaster" %>
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>

<!doctype html>
<html lang="en">
<head runat="server">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title></title>
    <link href="/Styles/css/main.css" rel="stylesheet" type="text/css" />
    <%-- <link href="Styles/open-iconic/font/css/open-iconic-bootstrap.css" rel="stylesheet"/>--%>
    <link href="/Styles/open-iconic/font/css/open-iconic-bootstrap.min.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <div id="loading" style="display:none">
        <div id="preview-area">
            <div class="spinner">
                <div class="rect1"></div>
                <div class="rect2"></div>
                <div class="rect3"></div>
                <div class="rect4"></div>
                <div class="rect5"></div>
            </div>
        </div>
    </div>
    <form id="Form1" runat="server">
    <asp:ScriptManager ID="ScriptManager1" EnablePageMethods="true" EnablePartialRendering="true"
        runat="server">
        <Services>
            <asp:ServiceReference InlineScript="False" Path="~/WebServer_01.svc" />
        </Services>
        <Scripts>
            <asp:ScriptReference Path="~/scripts/jim_UtilityModules.js" />
        </Scripts>
    </asp:ScriptManager>
    <header class="container-fluid bg-light px-3 py-4">
        <div class="row">
            <div class="col-sm">
                <img src="/Styles/images/logo.png" class="py-3" id="logo" alt="Logo"/>
            </div>
            <div class="col-sm text-sm-right my-sm-auto">
                <p><asp:Label ID="Label1" runat="server" Text="BW ... Database"/><br/>
                <asp:Label ID="lSystem" CssClass="text-muted" runat="server"/></p>
                <asp:LinkButton ID="lnkUnitStatus" CssClass="btn btn-outline-dark" role="button" runat="server">Unit Status Update</asp:LinkButton>
            </div>
        </div>
    </header>
    <%--        <header class="container-fluid bg-light px-3 py-4">
            <div class="row">
    	        <div class="col-sm">
                    <h1><asp:Label runat="server" Text="BW ... Database"/></h1>
                    <p><asp:Label ID="lSystem" runat="server"/></p>
                </div>
                <div class="col-sm text-sm-right my-sm-auto">
                    <asp:LinkButton ID="lnkUnitStatus" CssClass="btn btn-outline-dark" role="button" runat="server">Unit Status Update</asp:LinkButton>
                </div>
            </div>
        </header>--%>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <span id="main-menu">
                    <asp:Menu DataSourceID="SiteMapDataSource2" ID="Menu2" runat="server" RenderingMode="List" IncludeStyleBlock="False" Orientation="Horizontal" StaticDisplayLevels="2" SkipLinkText="">
                        <StaticMenuStyle CssClass="navbar-nav" />
                        <StaticMenuItemStyle CssClass="nav-link" />
                        <DynamicMenuStyle CssClass="dropdown-menu" />
                        <DynamicMenuItemStyle CssClass="dropdown-item" />
                    </asp:Menu>
                    <asp:SiteMapDataSource ID="SiteMapDataSource2" runat="server" />
                </span>
                <ul class="navbar-nav ml-auto">
                    <asp:LoginView ID="HeadLoginView" runat="server" EnableViewState="false">

                        <AnonymousTemplate>
                            <li class="nav-item">
                                <a class="nav-link" href="~/Account/Login.aspx" id="HeadLoginStatus" runat="server">Log In</a>
                            </li>
                        </AnonymousTemplate>

                        <LoggedInTemplate>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">
                                    <asp:LoginName ID="HeadLoginName" runat="server"/>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right">
                                    <a class="dropdown-item" href="~/Account/ChangePassword.aspx" id="A2" runat="server">Change Password</a>
                                    <a class="dropdown-item" href="~/Account/ChangePin.aspx" id="A1" runat="server">Change Pin</a>
                                    <asp:LoginStatus ID="HeadLoginStatus" CssClass="dropdown-item" runat="server" LogoutAction="Redirect" LogoutText="Log Out" LogoutPageUrl="~/" />
                                </div>
                            </li>
                        </LoggedInTemplate>
                    </asp:LoginView>
                </ul>

            </div>
    </nav>
    <main class="container mb-3"><asp:ContentPlaceHolder ID="cMC" runat="server" /></main>
    <footer class="footer"></footer>




    <!-- Bootstrap -->
    <!-- CDN (internet required) -->
